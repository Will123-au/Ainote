# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ---------- Security (strongly recommended) ----------
# Password for the API. Put the SAME value in Obsidian:
#   Note Companion -> License key / API key
# Make one with:  openssl rand -hex 24
#   (Windows PowerShell: -join ((1..48) | % { '{0:x}' -f (Get-Random -Max 16) }) )
SOLO_API_KEY=change-me-to-a-long-random-string

# Self-host mode: no Clerk login, no database needed
ENABLE_USER_MANAGEMENT=false

# ---------- AI provider (need at least one) ----------
OPENAI_API_KEY=sk-...

# Optional: use a local model on this laptop (Ollama). Uncomment both:
# OPENAI_API_KEY=ollama
# OPENAI_API_BASE=http://host.docker.internal:11434/v1

# Optional: separate Whisper server for transcription
# OPENAI_WHISPER_BASE_URL=http://host.docker.internal:9000/v1

# Optional: other providers
# MODEL_PROVIDER=openai        # openai, anthropic, google, groq, mistral, deepseek
# MODEL_NAME=gpt-4o-mini
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=

# ---------- Ports ----------
# Port on the laptop (container always uses 3000 inside)
HOST_PORT=3000

# ---------- Tailscale container (only for --profile tailscale) ----------
# Make a key at https://login.tailscale.com/admin/settings/keys
# (Reusable: off is fine. Pre-approved: on if you use device approval.)
TS_AUTHKEY=tskey-auth-...
TS_HOSTNAME=ainote
